import { Component<% if (!!viewEncapsulation) { %>, ViewEncapsulation<% }%><% if (changeDetection !== 'Default') { %>, ChangeDetectionStrategy<% }%> } from '@angular/core';<% if(standalone) { %>
import { MatTreeModule } from '@angular/material/tree';
import { MatButtonModule } from '@angular/material/button';
import { MatIconModule } from '@angular/material/icon';<% } %>
import { files } from './example-data';

/** File node data with possible child nodes. */
export interface FileNode {
  name: string;
  type: string;
  children?: FileNode[];
}

@Component({
  selector: '<%= selector %>',<% if (inlineTemplate) { %>
  template: `
    <%= indentTextContent(resolvedFiles.template, 4) %>
  `,<% } else { %>
  templateUrl: './<%= dasherize(name) %>.component.html',<% } if (inlineStyle) { %>
  styles: `
    <%= indentTextContent(resolvedFiles.stylesheet, 4) %>
  `<% } else { %>
  styleUrl: './<%= dasherize(name) %>.component.<%= style %>'<% } %><% if(!!viewEncapsulation) { %>,
  encapsulation: ViewEncapsulation.<%= viewEncapsulation %><% } if (changeDetection !== 'Default') { %>,
  changeDetection: ChangeDetectionStrategy.<%= changeDetection %><% } %><% if(standalone) { %>,
  imports: [MatTreeModule, MatButtonModule, MatIconModule]<% } else { %>,
  standalone: false<% } %>
})
export class <%= classify(name) %>Component {
  /** The data source for the tree. */
  readonly dataSource: FileNode[] = files;

  /** Returns the child nodes for a given node. */
  childrenAccessor = (node: FileNode) => node.children ?? [];

  /** Returns whether the node has children. */
  hasChild = (_: number, node: FileNode) => !!node.children && node.children.length > 0;
}
