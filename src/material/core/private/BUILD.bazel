load("//tools:defaults.bzl", "ng_project", "ng_web_test_suite")

package(default_visibility = ["//visibility:public"])

ng_project(
    name = "private",
    srcs = [
        "index.ts",
        "ripple-loader.ts",
    ],
    deps = [
        "//:node_modules/@angular/common",
        "//:node_modules/@angular/core",
        "//src/cdk/platform",
        "//src/cdk/private",
        "//src/material/core:ripple",
        "//src/material/core/animation",
    ],
)

ng_project(
    name = "unit_tests_lib",
    testonly = True,
    srcs = glob(["**/*.spec.ts"]),
    deps = [
        ":private",
        "//:node_modules/@angular/core",
        "//src/cdk/testing/private",
        "//src/material/core:ripple",
        "//src/material/core/animation",
    ],
)

ng_web_test_suite(
    name = "unit_tests",
    deps = [":unit_tests_lib"],
)
